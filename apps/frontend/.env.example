# The site's domain, identical in the backend: the news site on it and the panel on `painel.`. Empty in development
# means `localhost` (site on localhost:3027, panel on painel.localhost:3027). Production, for example:
# SITE_DOMAIN=metanews.com.br
SITE_DOMAIN=
# The API's base URL, reached by this server only: in production `https://api.<SITE_DOMAIN>` or the API service's
# internal address, without a path. `npm run dev` derives it from the root .env (BACKEND_PORT).
BACKEND_INTERNAL_URL=http://localhost:30027
