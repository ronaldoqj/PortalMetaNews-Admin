# Portal Meta News API settings, validated at start by src/config/environment.validation.ts: a missing or malformed
# required value stops the API with the names of the offending keys (never their values). Copy to .env for local use;
# in production set them in the deployment's environment. Never commit .env.

# development | production. Production turns on stricter checks (HTTPS endpoints, setup token, no local AI fallback).
NODE_ENV=development
# The API's port. `npm run dev` takes it from BACKEND_PORT in the root .env (30027), so leave it out locally.
# PORT=30027

# --- Database (PostgreSQL 17) ---------------------------------------------------------------------------------------
# Locally: the Compose database of this folder (`npm run db:up`), on POSTGRES_PORT 5427, user and password from .env.docker.
DATABASE_URL=postgresql://pmn:change-me@localhost:5427/portalmetanews
# true: connect over TLS and verify the server certificate (managed databases).
DATABASE_SSL=false
# Connections the API opens at most (1-100).
DATABASE_POOL_MAX=10

# --- Secrets --------------------------------------------------------------------------------------------------------
# 64 hexadecimal characters: `openssl rand -hex 32`. It protects only integration credentials (SMTP password, AI key).
# Changing it makes those stored credentials unreadable: they must be entered again in the panel.
APP_SECRET_KEY=

# --- Hosts ----------------------------------------------------------------------------------------------------------
# Exact browser origins allowed to call the API, comma-separated, no wildcard. `npm run dev` derives it locally.
CORS_ORIGINS=http://localhost:3027
# The site's domain: the news site on it, the panel on `painel.` and the API on `api.`.
SITE_DOMAIN=localhost
# The site's public origin for links the API writes (RSS, e-mails). Empty: derived from SITE_DOMAIN.
SITE_PUBLIC_URL=

# --- First panel administrator --------------------------------------------------------------------------------------
# One-time secret (24-256 characters) typed in the browser to create the first administrator. Required in production;
# remove it after the first access.
PANEL_SETUP_TOKEN=
# Alternative to the browser: the API creates the account at start while none exists. Password: 12-128 characters,
# three of lowercase, uppercase, digits and symbols, not containing the e-mail. Remove the three after the first start.
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- File storage ---------------------------------------------------------------------------------------------------
# local: the server's disk (needs a persistent volume in production) | s3: an S3-compatible bucket (R2, S3, MinIO).
STORAGE_DRIVER=local
# Local driver only: directory of the files; relative paths start at this folder.
STORAGE_LOCAL_DIR=./storage
# Largest single image upload, in megabytes (1-100).
UPLOAD_MAX_MB=15
# S3 driver only: all of S3_ENDPOINT (https), S3_BUCKET_NAME, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY and S3_KEY_PREFIX.
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Environment namespace inside a shared bucket (dev, prd).
S3_KEY_PREFIX=
S3_REGION=auto
# true for MinIO and other servers that need path-style addressing.
S3_FORCE_PATH_STYLE=false

# --- Artificial intelligence (translation, AI writer, images) -------------------------------------------------------
# The server's Gemini key, used while the panel stores none. Without any key, outside production, the deterministic
# local provider answers (offline: simulated translation and drafts, placeholder images). A key saved in the panel wins.
GEMINI_API_KEY=
# Text model (translation and writing) and image model (covers). Empty: gemini-2.5-flash and gemini-2.5-flash-image.
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=

# --- Background work ------------------------------------------------------------------------------------------------
# false on replicas that should only serve requests: scheduled news are published by one instance.
SCHEDULER=true

# --- E-mail (optional) ----------------------------------------------------------------------------------------------
# Relay for the contact form notice and temporary passwords. Port 465 needs SMTP_SECURE=true; 587 and 25 need false.
# The panel can also store its own SMTP settings, which take precedence.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
