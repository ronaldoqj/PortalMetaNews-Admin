# Demonstration data: categories, tags, authors, illustrated bilingual news and the front page.
# Copy to `.env.demo-seed` (ignored by Git) and fill in test-only credentials, then run `npm run db:seed:demo`.
# Passwords: 12-128 characters with at least three of lowercase, uppercase, digits and symbols.
# Development only: the seed refuses to run with NODE_ENV=production.

# Administrator (system role "Administrador"): created by the seed when no administrator exists yet.
ADMIN_BOOTSTRAP_NAME='Redação Meta News'
ADMIN_BOOTSTRAP_EMAIL=admin@seed.metanews.test
ADMIN_BOOTSTRAP_PASSWORD=

# The editorial team (editor@, reporter@ and reviewer@seed.metanews.test), all with this password.
SEED_TEAM_PASSWORD=

# With SEED_RESET_CONTENT=1 the seed first removes every news item, category, tag and media item it can find.
SEED_RESET_CONTENT=1
