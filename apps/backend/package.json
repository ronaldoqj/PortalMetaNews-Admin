{
  "name": "backend",
  "version": "0.1.0",
  "description": "Portal Meta News API: news, bilingual editorial workflow, AI writer, media, themes and the administrative panel.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.20.x",
    "npm": ">=11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "nest build",
    "admin:bootstrap": "npm run build && node --env-file-if-exists=.env dist/common/admin-access/bootstrap.js",
    "db:down": "docker compose --env-file .env.docker down",
    "db:logs": "docker compose --env-file .env.docker logs --follow postgres",
    "db:migrate": "npm run build && node --env-file-if-exists=.env dist/common/database/migrate.js",
    "db:reset": "docker compose --env-file .env.docker down --volumes --remove-orphans && docker compose --env-file .env.docker up --detach --wait postgres && npm run db:migrate",
    "db:seed:demo": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.demo-seed dist/common/database/seed-demo.js",
    "db:up": "docker compose --env-file .env.docker up --detach --wait postgres",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "node ../../scripts/dev.mjs backend",
    "start:dev": "node ../../scripts/dev.mjs backend",
    "start:debug": "node ../../scripts/dev.mjs backend --debug",
    "start:prod": "node dist/common/database/migrate.js && exec node dist/main",
    "storage:check": "npm run build && node --env-file-if-exists=.env dist/common/storage/check-storage.js",
    "storage:copy-local": "npm run build && node --env-file-if-exists=.env dist/common/storage/copy-local-to-bucket.js",
    "mail:check": "npm run build && node --env-file-if-exists=.env dist/common/admin-access/check-smtp.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:database": "PMN_DATABASE_TESTS=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run --testTimeout=20000 --hookTimeout=30000 integration.spec",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@google/genai": "^1.33.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "aws-sdk-client-mock": "^4.1.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
